# Copy this file to .env and replace the placeholder with a local-only password.
SHELFSIGHT_DB_PASSWORD=replace-with-a-local-password
SHELFSIGHT_DB_PORT=5432
SHELFSIGHT_DATABASE_URL=postgresql+psycopg://shelfsight:replace-with-a-local-password@127.0.0.1:5432/shelfsight
# Separate database for the test suite. Tests insert and delete rows, so never reuse the application database.
SHELFSIGHT_TEST_DATABASE_URL=postgresql+psycopg://shelfsight:replace-with-a-local-password@127.0.0.1:5432/shelfsight_test
SHELFSIGHT_MEDIA_ROOT=./media-local
SHELFSIGHT_IMPORT_ROOT=./import-local
# Generate password hashes with: python -m shelfsight_api.auth_cli
SHELFSIGHT_AUTH_USERS=[{"username":"owner","role":"owner","password_hash":"replace-with-scrypt-hash"}]
# Keep false only for local HTTP. Use true behind HTTPS.
SHELFSIGHT_SESSION_COOKIE_SECURE=false
# Optional local FiftyOne projection database
FIFTYONE_DATABASE_DIR=./fiftyone-local/database
# Optional model-worker configuration
# SHELFSIGHT_RFDETR_CHECKPOINT=path/to/checkpoint_best_total.pth
# SHELFSIGHT_RFDETR_VERSION=1.8.3-one-epoch
# SHELFSIGHT_SAM3_CHECKPOINT=path/to/sam3.pt
# SHELFSIGHT_SAM3_VERSION=46957e47805eaa273f4aa7bbbd25a88bca9108ce
# SHELFSIGHT_CLIP_MODEL_ROOT=path/to/openai-clip-vit-base-patch32-snapshot
